# Ambiente Wayland descartável para validar o caminho ScreenCast + PipeWire do PixelPointer.
# Pacotes resolvidos pelo snapshot Debian fixado; nenhum serviço do host é usado.
FROM docker.io/library/python@sha256:57b29a7c050c4e679e4bea572e14b3965cf4b5839de2da49d55e49ffc4024f39
RUN rm /etc/apt/sources.list.d/debian.sources && \
    printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261029T000000Z/ trixie main\ndeb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20261029T000000Z/ trixie-security main\n' > /etc/apt/sources.list && \
    apt-get -o APT::Sandbox::User=root update -qq && \
    apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
      sway swaybg xdg-desktop-portal xdg-desktop-portal-wlr pipewire pipewire-bin wireplumber \
      dbus-daemon dbus-bin imagemagick libfontconfig1 libwayland-egl1 libdecor-0-0 && \
    dpkg-query -W -f='${Package}\t${Version}\n' > /opt/native-packages.tsv && \
    rm -rf /var/lib/apt/lists/*
COPY sway.conf xdpw.conf run.sh /opt/wayland/
RUN mkdir /evidence && chown 1000:1000 /evidence
ENV LANG=C.UTF-8 TZ=UTC HOME=/tmp/home XDG_RUNTIME_DIR=/tmp/runtime XDG_CONFIG_HOME=/tmp/home/.config \
    XDG_STATE_HOME=/tmp/home/.local/state XDG_DATA_HOME=/tmp/home/.local/share XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=sway \
    WLR_BACKENDS=headless WLR_RENDERER=pixman WLR_LIBINPUT_NO_DEVICES=1
USER 1000:1000
ENTRYPOINT ["sh", "/opt/wayland/run.sh"]
