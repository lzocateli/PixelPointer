{
  "$comment": "Semente do Altivy.Groundwork: pertence ao projeto e é lida pelos workflows gw-*. Revise mudanças em PR.",
  "schemaVersion": 1,
  "releaseDependencies": [],
  "distributionAfterValidation": true,
  "defaultBranch": "main",
  "commitScopes": ["app", "core", "rendering", "capture", "hotkeys", "overlay", "ipc", "platform", "linux", "windows", "macos", "packaging", "tests", "docs", "tooling", "deps", "actions", "repo"],
  "dotnet": {
    "sdkImage": "lzocateli/dotnet-sdk:10.0.403-noble-v1",
    "solution": ""
  },
  "versionFiles": ["Directory.Build.props"],
  "publishSnapshots": true,
  "preview": {
    "enabled": true,
    "suffix": "rc",
    "requiredForRelease": true,
    "acceptance": "approval"
  },
  "deploy": {
    "environments": ["quality", "production"],
    "previewEnvironment": "quality",
    "autoDeployEnvironment": "quality"
  },
  "attestations": true,
  "rollbackMinimumVersion": "0.0.0"
}
