<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PixelPointer.App</RootNamespace>
    <AssemblyName>pixelpointer</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PixelPointer.Core/PixelPointer.Core.csproj" />
    <ProjectReference Include="../PixelPointer.Rendering/PixelPointer.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets/pixelpointer.svg" Link="pixelpointer.svg" TargetPath="pixelpointer.svg"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PixelPointer.UnitTests" />
  </ItemGroup>

  <Target Name="BuildScreenCaptureKitBridge" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="swiftc -O -emit-library -framework ScreenCaptureKit -framework CoreGraphics -framework CoreMedia -framework CoreVideo -Xlinker -install_name -Xlinker @rpath/libPixelPointerScreenCaptureKit.dylib -o &quot;$(PublishDir)libPixelPointerScreenCaptureKit.dylib&quot; &quot;$(MSBuildProjectDirectory)/MacOS/ScreenCaptureKitBridge.swift&quot;" />
  </Target>

</Project>
